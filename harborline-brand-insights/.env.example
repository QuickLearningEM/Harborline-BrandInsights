# Copy to .env and fill in. Never commit .env.

# --- Required in production ---
SITE_DOMAIN=insights.example.com
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
BI_SESSION_SECRET=

# --- Warehouse (sqlite for demos, snowflake for production) ---
BI_WAREHOUSE_BACKEND=snowflake
BI_SNOWFLAKE_ACCOUNT=
BI_SNOWFLAKE_USER=
BI_SNOWFLAKE_PRIVATE_KEY_PATH=/run/secrets/snowflake_key.p8
BI_SNOWFLAKE_ROLE=BI_PIPELINE
BI_SNOWFLAKE_WAREHOUSE=BI_WH
BI_SNOWFLAKE_DATABASE=BRAND_INSIGHTS
BI_SNOWFLAKE_SCHEMA=PUBLIC

# --- Ingestion ---
BI_LANDING_DIR=data/landing
BI_YOUTUBE_API_KEY=
BI_YOUTUBE_SEARCH_TERMS=Harborline Home,Nest & Co. furniture

# --- Analytics (defaults shown) ---
# BI_UNDER_INVESTED_INDEX=120
# BI_OVER_INVESTED_INDEX=80
# BI_MIN_SENTIMENT_SAMPLE=30
# BI_SENTIMENT_CLASSIFIER=lexicon   # or llm (needs BI_ANTHROPIC_API_KEY)
# BI_ANTHROPIC_API_KEY=
